 "blocks": [
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0001",
   "pid": "nao-729572",
   "pages": [
    1
   ],
   "text": "右以飛鳥井雅枝郷自筆之本写之畢五十番自歌合後門貞徳俊門貞徳一番初春待蔵左声のあやと朝織そめし鶯にとはゝやいつと花の錦を右年なみは越てもあたし契よな桜は春のすゑの松山二番山路尋花左夢かとよみしをしるへの山路には雲と成行ときのおもかけ",
   "poems": [
    "1",
    "2",
    "3"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0002",
   "pid": "nao-729572",
   "pages": [
    2
   ],
   "text": "右山深み誰にとはましさく花は匂ひのみこそしるへなりけれ三番山花未遍左白雲のかゝらぬ奥の山のはに花の盛のみなたをそしる散そめし花と思はゝうからましまた咲そはぬ山桜かなお四番胡見花左たをやめのむかふ鏡の玉遼ひらくる花に有明のかけ右夜のまにし咲たる花の匂はすは唯初雪の曙の山五番遠村花左白雲か何そとゝへはしつのおかそれその村の老とこたふる蜑やすむ磯山もとのうす煙思はぬ老にたなひきにけり七六番故郷花左人はなとかはる習ひと故郷のむかしに匂ふ花や思はむ",
   "poems": [
    "4",
    "5",
    "6",
    "7",
    "8",
    "9",
    "10",
    "11"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0003",
   "pid": "nao-729572",
   "pages": [
    3
   ],
   "text": "右故郷は心地申とはす人もなしなまめく春の花はあれとも七番田家蔵左氷口に花のうつろふ山里は昼の底にてかはつ鳴なり秋の田のかりほの桜咲にけり猶ひたかけて春もれかし右八番古寺蔵左かくらくのはつせの花の春風やもろこしまそも匂ひ行覧の君にまたひきたまひたまひける誰うへて年ふる寺の桜宅絶せぬ春の手向なからん九番花似香左雪にまてまかひはてけれ山楼雲はたちゐに替るおもにけ見まかしためしそ思ふ岡谷にかゝやく花をこその白昼右十番河辺花左一花を思ふ人の涙の積てや吉野の川となかれそめけん",
   "poems": [
    "12",
    "13",
    "14",
    "15",
    "16",
    "17",
    "18",
    "19"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0004",
   "pid": "nao-729572",
   "pages": [
    4
   ],
   "text": "右木のもとにさそふ水あれはちらぬまの川への桜あからめなせそ十一番深山蔵左おゝな人も又ふみ散す鳥もなしもやま桜はもるとなけれと七人はなと友による覧源山来の中にも花は咲に遣るまな十二番暮山花左暮ぬれと花の光に山鳥の尾上の春の日こそなかけれ右夕くれに咲そふ物は白雲のかへる山へのさくら成けり十三番古渓花左一埋木とならぬ梢もなかりけりみ谷の梅咲やそふめ右谷川の浪の初花そのまゝに咲かさねたる山さくらかな十四番関路花左あふ坂やまた明ぬ夜も曙の花にや遊る春のせき守",
   "poems": [
    "20",
    "21",
    "22",
    "23",
    "24",
    "25",
    "26",
    "27"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0005",
   "pid": "nao-729572",
   "pages": [
    5
   ],
   "text": "いにしへの関路のあとの桜花いまも往来の人そとめける廿十五番羇中蔵左やすくとも花なき里はあかせん春は桜の陰にそねめ老こそは旅のあたなれこれみすは都の春も思出しを七十六番湖上花左湖の海や春の湊と成にけり老吹おろす四方の山風おひをおもとひつれける酢むららひこともふきやせのゆき七散てこし山や見なめのなかる覧塩ならぬ海そ老に成行十七番橋下蔵左〽老の波なかめんとてやかけつらん常は水なき山川のはし右右仙人の雲にのるとふ心ちして花の梢やねたるいはゝし十八番花下送日左〽老見つゝしらぬ日数も故郷にかへるをまつや久しかるらん",
   "poems": [
    "28",
    "29",
    "30",
    "31",
    "32",
    "33",
    "34",
    "35",
    "36"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0006",
   "pid": "nao-729572",
   "pages": [
    6
   ],
   "text": "右なれりし花の木陰のいな莚散面皮そしきしのふへき十九番庭上落尤左散見てし跡の梢はみとりにて庭の苔ちそ花に成ぬる右ちる花を又ことかたにちらさしといとひもやまぬ庭の春風廿番暮春惜花左何ゆへに春の別れを惜むとも思ひしらはや花のちか覧一さん梅さきたつふさへやきまたねの菜をしたまたり右暮ぬまの春をたのみて大かたに惜らし老の日数さへうき廿一番初秋月左吹風の音にのは聞初秋をさやかにみする月の影かな右一葉ちる柊の糸のたえまよりくる秋ほそき月の影かな廿二番月前草花左夜もすから月もあかすやなかむらん千種の声を照す光りは",
   "poems": [
    "37",
    "38",
    "39",
    "40",
    "41",
    "42",
    "43",
    "44"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0007",
   "pid": "nao-729572",
   "pages": [
    7
   ],
   "text": "右秋野のゝ千草のおんを関の夜の錦となすな山のはの月廿三番雨後月左音は猶軒の雫に残しをきて月より先に晴る村雨右かきくれて降にし雨も時のまにうつりかはれる月の影かな廿四番松間月左かそへなはかそへよとてやこまかなる松の葉こしにすめる月影つれもなき我よもいつか我宿のまつに見はてん有明の月右廿五番山家月左立出て誰をとはまし山ふかみ見ぬ人もなし秋の夜の月都にはいく家々に詠らん我のみむかふ屋まの橋の月右廿六番月前竹風左夜もすから月影さやく竹の葉に窓打雨の音をみるかな",
   "poems": [
    "45",
    "46",
    "47",
    "48",
    "49",
    "50",
    "51",
    "52"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0008",
   "pid": "nao-729572",
   "pages": [
    8
   ],
   "text": "右〽おきふすは月やぬるつく大てみのかきほの竹の風のよすから廿七番野経月左夜もすからゐなの篠はら露落て宿なき月に秋風そふく右打わたす遠方人も諸たえて野もせに白き月の新かな廿八番沢辺月左あまの原同し光に広沢の水の底にもすめる月かな沢辺には水草きよしいつくふもすまぬまさると月やすむらん右廿九番月前閉会左霞なはとわたる鳫や帰らましさこそもさへよ秋の夜の月右春霞たつを見捨し心まてさやけき月に渡るかりかね卅番浦辺月左更行はあまの子ならぬ月かけも浦つたひして宿もさためす",
   "poems": [
    "53",
    "54",
    "55",
    "56",
    "57",
    "58",
    "59",
    "60"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0009",
   "pid": "nao-729572",
   "pages": [
    9
   ],
   "text": "月影者明右の浦のいさり火は燈はかりそ見へ渡りける七卅一番月照瀧水左秋は月のかつらの花をせき入ておとす音羽の瀧の白浪右雲きりも那智のお山の秋の夜は月より落る瀧の白波卅二番杜間月霍公鳴声よりも片岡のもりてかなしき秋の夜の月左月そとふ秋のはつかせ日数へていくたの杜や落葉しぬらん右卅三番月前秋風きえかへり又たつ雲も有やとて月を見捨ぬさよの秋風九右閨と見し雲のうちより吹初てあふきににたる月の秋風卅四番江上月左ことゝはん堀江の月の都鳥玉しきし代の秋もかくやと",
   "poems": [
    "61",
    "62",
    "63",
    "64",
    "65",
    "66",
    "67",
    "68"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0010",
   "pid": "nao-729572",
   "pages": [
    10
   ],
   "text": "秋の夜も昔をしらは玉くしけはやくな明そ水の江の月右卅五番月前虫左鳴虫の泪くたけて見ゆるかな夜さむの月に千ゝの白露見ることゝ聞てふもの哀さは月になるみの野辺の虫の音右卅六番月前図鹿左はてしなき哀そこもなさをしかの月に妻とふ武蔵野のはら七ます出来を見ゆるものなるにも秋やうき妻やこほし支有明の月やをしかの夜もすからなく卅七番旅泊月左日くなれはこきて入江の波の上に月の御船やさして出らん右かはらぬやかはるうきねのことはに波の手枕袖の月かけ卅八番月前草露九をきわたすかけ野の草の夕露の光もいつる山のはの月",
   "poems": [
    "69",
    "70",
    "71",
    "72",
    "73",
    "74",
    "75",
    "76"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0011",
   "pid": "nao-729572",
   "pages": [
    11
   ],
   "text": "七右浅芽生のをのれとおつる白露はやとれる月の影やあまれる卅九番菊籬月白菊の色もへたてす夕暮の籬の山路いゝある月かけ左月すめはかくるゝ星の空よりや折かけ垣の白菊の花七四十番暮秋暁月左長月の末野にのこり鳴虫の声よりほそき有明のかけ右初秋のみそめし影に帰るかな暮はてしすゑの弓張の月四十一番寄雲恋左いかにせんあしたの雲の跡もなし見しよは夢の契なれとも右さゝかにのくものはたてを打なかめくへきよひとはいつか頼まむ四十二番寄風恋九なれたにも又偽の数そへてこぬ夜のねやをたゝくさよかせ",
   "poems": [
    "77",
    "78",
    "79",
    "80",
    "81",
    "82",
    "83",
    "84"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0012",
   "pid": "nao-729572",
   "pages": [
    12
   ],
   "text": "七君に今さはりとなるにくらふれは月に恨みし雨はものかは花四十三番寄両窓そよさらに音やはせさるさゝの葉のみ山飛ははけしけれとも七もろともにきかはなしもつらかくしこぬ夜のぬらわか袂かな左四十四番寄卓恋袖の露なにゝつゝまん秋の野の千種の袂我にかさなん七恋侘て我身の土となる野には思筆のみおふとしらなん四十五番寄木恋左稲荷山いのる月日のしるしをはいつか見もとの杉の下みち右右独ある身はから崎の松なれや見るめ渚に年をふりつゝ四十六番寄鳥恋たうら山しねに行鳥も君かすむ宿の梢の夕暮のそら",
   "poems": [
    "85",
    "86",
    "87",
    "88",
    "89",
    "90",
    "91",
    "92"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0013",
   "pid": "nao-729572",
   "pages": [
    13
   ],
   "text": "いかにしてつねはまたなし鳥の音のあふ夜をしりてはき鳴らん七四十七番寄嵐恋左誰かいふむへ山かせをあらしとは人の心の秋もしらすて右たのみなきうつゝそ頼むあふことの夢路はこよひ嵐吹らん四十八番寄船恋左縦はつる夢の通路舟もなし枕の下に海はあれとも右渕は瀬に川風吹てさす舟のあたなる波にぬるゝ袖かな四十九番寄琴恋左あふせなき水の音にやかよふらん泪かきなす玉のをことは右いとむそふためしも有に玉琴のたま〳〵くるを引もとゝめす五十番寄衣恋左人しれぬ中の衣のへたてこそきてねぬよりも苦しかりけれ",
   "poems": [
    "93",
    "94",
    "95",
    "96",
    "97",
    "98",
    "99",
    "100"
   ]
  },
  {
   "id": "zoku-gunsho-gojuban-jikaawase-0014",
   "pid": "nao-729572",
   "pages": [
    14
   ],
   "text": "君をなとおもふ色にはかへるらんうき世にそさぬすみそめのそて七此貞徳自五十番欲含彼翁以自筆本冩之訖尤可為証本者也中秋中三日貞徳翁自歌合一番草花早左ほし合のそらやうらみむはつ秋の歌にひとくなゝくさの花右むしも又はたをりそめぬ秋野の老のにしきはたれかいそきし二番旅天雁左人やかの道かとそおもふ時しもあれうき秋かせにわたるよりかね右",
   "poems": [
    "101",
    "102",
    "103",
    "104"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "声のあやと朝織そめし鶯にとはゝやいつと花の錦を",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "年なみは越てもあたし契よな桜は春のすゑの松山",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "夢かとよみしをしるへの山路には雲と成行ときのおもかけ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "山深み誰にとはましさく花は匂ひのみこそしるへなりけれ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "白雲のかゝらぬ奥の山のはに花の盛のみなたをそしる",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "散そめし花と思はゝうからましまた咲そはぬ山桜かな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "たをやめのむかふ鏡の玉遼ひらくる花に有明のかけ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "夜のまにし咲たる花の匂はすは唯初雪の曙の山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "白雲か何そとゝへはしつのおかそれその村の老とこたふる",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "蜑やすむ磯山もとのうす煙思はぬ老にたなひきにけり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "人はなとかはる習ひと故郷のむかしに匂ふ花や思はむ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "故郷は心地申とはす人もなしなまめく春の花はあれとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "氷口に花のうつろふ山里は昼の底にてかはつ鳴なり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "秋の田のかりほの桜咲にけり猶ひたかけて春もれかし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "かくらくのはつせの花の春風やもろこしまそも匂ひ行覧",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "16",
   "text": "誰うへて年ふる寺の桜宅絶せぬ春の手向なからん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "雪にまてまかひはてけれ山楼雲はたちゐに替るおもにけ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "見まかしためしそ思ふ岡谷にかゝやく花をこその白昼",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "一花を思ふ人の涙の積てや吉野の川となかれそめけん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "20",
   "text": "木のもとにさそふ水あれはちらぬまの川への桜あからめなせそ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "おゝな人も又ふみ散す鳥もなしもやま桜はもるとなけれと",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "22",
   "text": "人はなと友による覧源山来の中にも花は咲に遣るまな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "暮ぬれと花の光に山鳥の尾上の春の日こそなかけれ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "24",
   "text": "夕くれに咲そふ物は白雲のかへる山へのさくら成けり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "25",
   "text": "一埋木とならぬ梢もなかりけりみ谷の梅咲やそふめ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "26",
   "text": "谷川の浪の初花そのまゝに咲かさねたる山さくらかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "27",
   "text": "あふ坂やまた明ぬ夜も曙の花にや遊る春のせき守",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "28",
   "text": "いにしへの関路のあとの桜花いまも往来の人そとめける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "29",
   "text": "やすくとも花なき里はあかせん春は桜の陰にそねめ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "30",
   "text": "老こそは旅のあたなれこれみすは都の春も思出しを",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "31",
   "text": "湖の海や春の湊と成にけり老吹おろす四方の山風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "32",
   "text": "おひをおもとひつれける酢むららひこともふきやせのゆき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "33",
   "text": "散てこし山や見なめのなかる覧塩ならぬ海そ老に成行",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "34",
   "text": "〽老の波なかめんとてやかけつらん常は水なき山川のはし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "35",
   "text": "仙人の雲にのるとふ心ちして花の梢やねたるいはゝし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "36",
   "text": "〽老見つゝしらぬ日数も故郷にかへるをまつや久しかるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "37",
   "text": "なれりし花の木陰のいな莚散面皮そしきしのふへき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "38",
   "text": "散見てし跡の梢はみとりにて庭の苔ちそ花に成ぬる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "39",
   "text": "ちる花を又ことかたにちらさしといとひもやまぬ庭の春風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "40",
   "text": "何ゆへに春の別れを惜むとも思ひしらはや花のちか覧",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "41",
   "text": "暮ぬまの春をたのみて大かたに惜らし老の日数さへうき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "42",
   "text": "吹風の音にのは聞初秋をさやかにみする月の影かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "43",
   "text": "一葉ちる柊の糸のたえまよりくる秋ほそき月の影かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "44",
   "text": "夜もすから月もあかすやなかむらん千種の声を照す光りは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "45",
   "text": "秋野のゝ千草のおんを関の夜の錦となすな山のはの月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "46",
   "text": "音は猶軒の雫に残しをきて月より先に晴る村雨",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "47",
   "text": "かきくれて降にし雨も時のまにうつりかはれる月の影かな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "48",
   "text": "かそへなはかそへよとてやこまかなる松の葉こしにすめる月影",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "49",
   "text": "つれもなき我よもいつか我宿のまつに見はてん有明の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "50",
   "text": "立出て誰をとはまし山ふかみ見ぬ人もなし秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "51",
   "text": "都にはいく家々に詠らん我のみむかふ屋まの橋の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "52",
   "text": "夜もすから月影さやく竹の葉に窓打雨の音をみるかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "53",
   "text": "〽おきふすは月やぬるつく大てみのかきほの竹の風のよすから",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "54",
   "text": "夜もすからゐなの篠はら露落て宿なき月に秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "55",
   "text": "打わたす遠方人も諸たえて野もせに白き月の新かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "56",
   "text": "あまの原同し光に広沢の水の底にもすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "57",
   "text": "沢辺には水草きよしいつくふもすまぬまさると月やすむらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "",
   "dai": ""
  },
  {
   "seq": "58",
   "text": "霞なはとわたる鳫や帰らましさこそもさへよ秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "59",
   "text": "春霞たつを見捨し心まてさやけき月に渡るかりかね",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "60",
   "text": "更行はあまの子ならぬ月かけも浦つたひして宿もさためす",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "61",
   "text": "月影者明右の浦のいさり火は燈はかりそ見へ渡りける",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "",
   "dai": ""
  },
  {
   "seq": "62",
   "text": "秋は月のかつらの花をせき入ておとす音羽の瀧の白浪",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "63",
   "text": "雲きりも那智のお山の秋の夜は月より落る瀧の白波",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "64",
   "text": "霍公鳴声よりも片岡のもりてかなしき秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "",
   "dai": ""
  },
  {
   "seq": "65",
   "text": "月そとふ秋のはつかせ日数へていくたの杜や落葉しぬらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "66",
   "text": "きえかへり又たつ雲も有やとて月を見捨ぬさよの秋風",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "67",
   "text": "閨と見し雲のうちより吹初てあふきににたる月の秋風",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "68",
   "text": "ことゝはん堀江の月の都鳥玉しきし代の秋もかくやと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "69",
   "text": "秋の夜も昔をしらは玉くしけはやくな明そ水の江の月",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "70",
   "text": "鳴虫の泪くたけて見ゆるかな夜さむの月に千ゝの白露",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "71",
   "text": "見ることゝ聞てふもの哀さは月になるみの野辺の虫の音",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "72",
   "text": "はてしなき哀そこもなさをしかの月に妻とふ武蔵野のはら",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "73",
   "text": "秋やうき妻やこほし支有明の月やをしかの夜もすからなく",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "74",
   "text": "日くなれはこきて入江の波の上に月の御船やさして出らん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "75",
   "text": "かはらぬやかはるうきねのことはに波の手枕袖の月かけ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "76",
   "text": "をきわたすかけ野の草の夕露の光もいつる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "77",
   "text": "浅芽生のをのれとおつる白露はやとれる月の影やあまれる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "78",
   "text": "白菊の色もへたてす夕暮の籬の山路いゝある月かけ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "79",
   "text": "月すめはかくるゝ星の空よりや折かけ垣の白菊の花",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "80",
   "text": "長月の末野にのこり鳴虫の声よりほそき有明のかけ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "81",
   "text": "初秋のみそめし影に帰るかな暮はてしすゑの弓張の月",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "82",
   "text": "いかにせんあしたの雲の跡もなし見しよは夢の契なれとも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "83",
   "text": "さゝかにのくものはたてを打なかめくへきよひとはいつか頼まむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "84",
   "text": "なれたにも又偽の数そへてこぬ夜のねやをたゝくさよかせ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "85",
   "text": "君に今さはりとなるにくらふれは月に恨みし雨はものかは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "86",
   "text": "そよさらに音やはせさるさゝの葉のみ山飛ははけしけれとも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "87",
   "text": "もろともにきかはなしもつらかくしこぬ夜のぬらわか袂かな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "88",
   "text": "袖の露なにゝつゝまん秋の野の千種の袂我にかさなん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "89",
   "text": "恋侘て我身の土となる野には思筆のみおふとしらなん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "90",
   "text": "稲荷山いのる月日のしるしをはいつか見もとの杉の下みち",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "91",
   "text": "独ある身はから崎の松なれや見るめ渚に年をふりつゝ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "92",
   "text": "うら山しねに行鳥も君かすむ宿の梢の夕暮のそら",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "93",
   "text": "いかにしてつねはまたなし鳥の音のあふ夜をしりてはき鳴らん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "94",
   "text": "誰かいふむへ山かせをあらしとは人の心の秋もしらすて",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "95",
   "text": "たのみなきうつゝそ頼むあふことの夢路はこよひ嵐吹らん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "96",
   "text": "縦はつる夢の通路舟もなし枕の下に海はあれとも",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "97",
   "text": "渕は瀬に川風吹てさす舟のあたなる波にぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "98",
   "text": "あふせなき水の音にやかよふらん泪かきなす玉のをことは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "99",
   "text": "いとむそふためしも有に玉琴のたま〳〵くるを引もとゝめす",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "100",
   "text": "人しれぬ中の衣のへたてこそきてねぬよりも苦しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "101",
   "text": "君をなとおもふ色にはかへるらんうき世にそさぬすみそめのそて",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "102",
   "text": "ほし合のそらやうらみむはつ秋の歌にひとくなゝくさの花",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "103",
   "text": "むしも又はたをりそめぬ秋野の老のにしきはたれかいそきし",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "104",
   "text": "人やかの道かとそおもふ時しもあれうき秋かせにわたるよりかね",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729572",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": ""
  }
 ],
